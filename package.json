{
  "name": "giftradar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "test": "npm run test:server && npm run test:web",
    "test:server": "GR_NO_LISTEN=1 node --test server/scrape.test.js",
    "test:web": "vitest run",
    "typecheck": "tsc --noEmit -p web"
  },
  "dependencies": {
    "antd-mobile": "^5.40.1",
    "cheerio": "^1.0.0",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.4"
  }
}